# AI Interview Platform - environment variables
# Copy to .env.local and fill in. Full reference: docs/configuration.md

# --- Core (required) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_platform
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI model (any OpenAI-compatible endpoint; no trailing /v1) ---
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o
# Optional separate model for scorecards (falls back to AI_*)
SUMMARY_AI_BASE_URL=
SUMMARY_AI_API_KEY=
SUMMARY_AI_MODEL=

# --- Speech-to-text ---
STT_PROVIDER=deepgram
STT_LANGUAGE=en-IN
DEEPGRAM_API_KEY=
SONIOX_API_KEY=
SARVAM_API_KEY=

# --- Text-to-speech: deepgram | edge | cartesia | elevenlabs | sarvam ---
TTS_PROVIDER=deepgram
EDGE_TTS_VOICE=en-IN-NeerjaNeural
EDGE_TTS_RATE=+10%
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- Proctoring and timing ---
MAX_PROCTORING_STRIKES=20
NEXT_PUBLIC_MAX_PROCTORING_STRIKES=20
HEARTBEAT_STALE_MS=180000
SILENCE_DELAY_MS=3000

# --- Video recording (camera + mic) ---
VIDEO_RECORDING=off

# --- Recruiter AI assistant (chat panel; needs migrations/003_agent_chat.sql) ---
AGENT_CHAT=off
# Comma-separated feature ids, empty = all: interviews,question-banks,resume-screening,interview-creation
AGENT_FEATURES=
# Optional separate model for the assistant (falls back to AI_*); needs good tool calling
AGENT_AI_BASE_URL=
AGENT_AI_API_KEY=
AGENT_AI_MODEL=

# --- Email (optional; logs to console when unset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
